# Backend do AtendeAI (FastAPI). Em docker-compose: http://backend:8001
BACKEND_URL=http://localhost:8001

# Porta HTTP do microserviço (health, status, qr, send)
WHATSAPP_SERVICE_PORT=3100

# Diretório onde as credenciais da sessão do WhatsApp são salvas
# (permite reconectar sem escanear o QR toda vez). Use um volume persistente.
AUTH_DIR=./auth_info

# Intervalo (ms) de heartbeat ao backend e recarga das configurações do console
HEARTBEAT_MS=60000

# Nível de log: info | debug | warn | error
LOG_LEVEL=info
